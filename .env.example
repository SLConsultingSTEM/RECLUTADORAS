# URL pública de la API Go (sin secretos). Obligatoria si VITE_USE_MOCK=false.
VITE_API_URL=https://api.ejemplo.com

# true = repositorios mock | false = HTTP real
# En desarrollo: si se omite, se usan mocks.
# En producción (vite build): si se omite, queda en false.
# Nunca desplegar producción con VITE_USE_MOCK=true salvo demos controladas.
VITE_USE_MOCK=false
